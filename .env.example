# ===== 应用 =====
# 基础
NODE_ENV=development
PORT=3000
VITE_API_BASE=/api
# 生产默认仅同源访问；前后端分域时填完整来源，以逗号分隔，无末尾斜杠。
CORS_ORIGINS=
# 只填写实际反向代理的 IP/CIDR；部署时按网络配置，不能填写 true 或 0.0.0.0/0。
TRUST_PROXY_CIDRS=

# ===== 数据库 / 中间件 =====
MONGO_URI=mongodb://localhost:27017/medibrain
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Compose 的 Neo4j 使用宿主机 7688；Neo4j Desktop 通常使用 7687。
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

MILVUS_HOST=milvus
MILVUS_PORT=19530

MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_ACCESS_KEY=medibrain
MINIO_SECRET_KEY=medibrain-secret

# ===== 大模型（多模型适配层）=====
# provider: deepseek | bailian | ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼（切换 LLM_PROVIDER=bailian 时使用）
BAILIAN_API_KEY=sk-xxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama 本地（切换 LLM_PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 阿里云 embedding
# ===== Embedding 向量检索（问答兜底）=====
# model: bge-m3（本地 Ollama，默认）| text-embedding-v4（阿里云）
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
# 阿里云 text-embedding-v4 时使用（EMBEDDING_MODEL=text-embedding-v4）
DASHSCOPE_API_KEY=sk-xxxx
# Milvus 向量库
MILVUS_URI=localhost:19540
MILVUS_COLLECTION=entities
EMBEDDING_TOP_K=5
EMBEDDING_THRESHOLD=0.6

# ===== 安全 =====
# 用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成。
JWT_SECRET=
JWT_EXPIRES=7d

# ===== 语音缓存（每个服务副本独立；最近访问后过期）=====
TTS_CACHE_TTL_SECONDS=86400
TTS_CACHE_MAX_BYTES=268435456
TTS_CACHE_MAX_FILES=512
TTS_MAX_CONCURRENT=2
