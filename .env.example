# ===== 应用 =====
# 基础
NODE_ENV=development
PORT=3000
VITE_API_BASE=/api

# ===== 数据库 / 中间件 =====
MONGO_URI=mongodb://mongo:27017/medibrain
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

MILVUS_HOST=milvus
MILVUS_PORT=19530

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=medibrain
MINIO_SECRET_KEY=medibrain-secret

# ===== 大模型（多模型适配层）=====
# provider: deepseek | bailian | ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼（切换 LLM_PROVIDER=bailian 时使用）
BAILIAN_API_KEY=sk-xxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama 本地（切换 LLM_PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 阿里云 embedding
# ===== Embedding 向量检索（问答兜底）=====
# model: bge-m3（本地 Ollama，默认）| text-embedding-v4（阿里云）
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
# 阿里云 text-embedding-v4 时使用（EMBEDDING_MODEL=text-embedding-v4）
DASHSCOPE_API_KEY=sk-xxxx
# Milvus 向量库
MILVUS_URI=localhost:19540
MILVUS_COLLECTION=entities
EMBEDDING_TOP_K=5
EMBEDDING_THRESHOLD=0.6

# ===== 安全 =====
JWT_SECRET=please-change-me
JWT_EXPIRES=7d

# ===== 管理员初始账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123